# --- Android / Gradle -------------------------------------------------------
build/
.gradle/
*.apk
*.aab
*.ap_
*.dex
*.class
local.properties
captures/
.cxx/

# --- Claude Code / agent tooling -------------------------------------------
# Project settings, skills and subagents ARE committed (they are part of the build system).
# Only local overrides and caches are ignored.
.claude/settings.local.json
.claude/*/cache/
.agents/skills/

# --- IDE --------------------------------------------------------------------
.idea/
*.iml
.vscode/
*.swp
*.swo

# --- Secrets (never committed) ---------------------------------------------
.env
.env.*
!.env.example
secrets/
*.key
*.pem
*.p12
*.keystore
*.jks
*.jwk
keystore.properties
api-keys.json
vault-export*.json

# --- Local models and big binaries -----------------------------------------
*.gguf
*.ggml
*.onnx
*.bin
models/
runtimes/

# --- Logs -------------------------------------------------------------------
# Task, daily and chain logs ARE committed (they are the audit trail and the
# handover evidence). Only the pruned archive and compressed old logs are local.
logs/archive/
*.log.gz

# --- Python ----------------------------------------------------------------
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# --- OS / temp --------------------------------------------------------------
.DS_Store
Thumbs.db
*.bak
*.tmp
*.orig
*.rej
